# Dockerfile for CPU-only execution
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy project files
COPY pyproject.toml .

# Create virtual environment and install dependencies with CPU extra
RUN uv venv && \
    uv sync --extra cpu --no-dev

# Copy application code
COPY . .

# Set environment to use the virtual environment
ENV PATH="/app/.venv/bin:$PATH"

# Default command (change to your real CLI)
CMD ["python", "-m", "tts-image-video-gen"]
